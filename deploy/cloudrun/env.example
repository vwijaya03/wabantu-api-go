# Salin ke deploy/cloudrun/.env (gitignored). Jangan isi nilai di file contoh ini.
# Secret Manager diisi terpisah. File ini hanya untuk host yang ikut ter-bake ke image.

GCP_PROJECT=wabantu
GCP_REGION=asia-southeast2
AR_REPO=wabantu
SERVICE_NAME=wabantu-api
RUNTIME_SA=wabantu-cloudrun

# Host tanpa skema. Pola: hostname atau hostname:port
SQL_HOST=
SQL_USER=
SQL_SYSTEM_DB=system
SQL_TENANT_DB=tenant

# Upstash hostname:port (bukan URL rediss://). Password ada di secret REDIS_AUTH.
REDIS_HOST=

# Kosong pada build pertama. Setelah Cloud Run punya URL, isi lalu build ulang.
CLOUD_RUN_URL=
